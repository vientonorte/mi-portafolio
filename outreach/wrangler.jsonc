{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vn-outreach",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "account_id": "6e96c77c41a11e043c84a7802c6108b8",
  // Sin hostname público hasta que Rö cree la app de Access y pegue la ruta.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      // Los invocation logs pueden guardar el header del JWT. El rastro útil
      // es el console.log estructurado, que no incluye destinatario ni token.
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      // Apagado: un trace puede guardar headers (JWT de Access, Svix).
      "enabled": false
    }
  },
  "kv_namespaces": [
    {
      "binding": "OUTREACH_KV",
      // Reemplazar con el id de `npx wrangler kv namespace create OUTREACH_KV` antes del deploy.
      "id": "00000000000000000000000000000000"
    }
  ],
  // Tope atómico en live y dedupe del webhook. Sin este binding, OUTREACH_MODE=live
  // responde 503 y no llama a Resend. El modo test sigue contando en KV.
  "durable_objects": {
    "bindings": [
      {
        "name": "OUTREACH_COUNTER",
        "class_name": "OutreachCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OutreachCounter"]
    }
  ],
  "vars": {
    "OUTREACH_MODE": "test"
    // TEST_ALLOWLIST no va en el repo. Var o secreto del dashboard.
    // Si falta o está vacía, /send en modo test responde 403.
  }
}
