# Copiar a .env.local — nunca commitear valores reales
# cp .env.example .env.local

# Analytics (opcional)
VITE_GA_MEASUREMENT_ID=
VITE_GTM_ID=

# Contacto — Google Forms (canal principal si está configurado)
# Form: https://docs.google.com/forms/d/e/1FAIpQLSc90BMntvUDgJW5H-xWzqEE0iUNOIFZ-lwa2Nk3ZQLWb7EmaQ/viewform
# Campos: Nombre · Correo · Mensaje · Motivo · Canal · Idioma — ver docs/CONTACT_AND_PRIVACY.md
# VITE_GOOGLE_FORM_ACTION_URL=https://docs.google.com/forms/d/e/1FAIpQLSc90BMntvUDgJW5H-xWzqEE0iUNOIFZ-lwa2Nk3ZQLWb7EmaQ/formResponse
# VITE_GOOGLE_FORM_ENTRY_NAME=entry.1017625325
# VITE_GOOGLE_FORM_ENTRY_EMAIL=entry.1353894548
# VITE_GOOGLE_FORM_ENTRY_MESSAGE=entry.844780369
# VITE_GOOGLE_FORM_ENTRY_INTENT=entry.1037750254
# VITE_GOOGLE_FORM_ENTRY_SOURCE=entry.453244438
# VITE_GOOGLE_FORM_ENTRY_LANGUAGE=entry.366145820

# Contacto — inbox FormSubmit (respaldo si Google Forms no está configurado)
# VITE_FORM_SUBMIT_INBOX=gaete.gaona@gmail.com

# Relay backup Cloudflare Worker (opcional)
# VITE_CONTACT_API_URL=https://mi-portafolio-contact.vientonorte.workers.dev/api/contact

# Agenda Google Calendar (Appointment Schedule)
# Crear: https://calendar.google.com/calendar/u/0/r/appointment
# Título sugerido: «VN · revisión a11y gratis (30 min)» · timezone America/Santiago
# Pegar el link público (calendar.app.google/… o appointments/schedules/…)
# VITE_A11Y_FREE_SCHEDULE_URL=https://calendar.app.google/XXXXXXXX
# Opcional: misma u otra agenda para partner educación
# VITE_VIDEO_CALL_URL=