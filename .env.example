# Copiar a .env.local — nunca commitear valores reales
# cp .env.example .env.local

# Analytics (opcional)
VITE_GA_MEASUREMENT_ID=
VITE_GTM_ID=

# Contacto — Google Forms (canal principal si está configurado)
# Crear formulario en cuenta gaete.gaona@gmail.com — ver docs/CONTACT_AND_PRIVACY.md
# VITE_GOOGLE_FORM_ACTION_URL=https://docs.google.com/forms/d/e/FORM_ID/formResponse
# VITE_GOOGLE_FORM_ENTRY_NAME=entry.123456789
# VITE_GOOGLE_FORM_ENTRY_EMAIL=entry.987654321
# VITE_GOOGLE_FORM_ENTRY_MESSAGE=entry.111222333
# VITE_GOOGLE_FORM_ENTRY_INTENT=entry.444555666
# VITE_GOOGLE_FORM_ENTRY_SOURCE=entry.777888999
# VITE_GOOGLE_FORM_ENTRY_LANGUAGE=entry.000111222

# Contacto — inbox FormSubmit (respaldo si Google Forms no está configurado)
# VITE_FORM_SUBMIT_INBOX=gaete.gaona@gmail.com

# Relay backup Cloudflare Worker (opcional)
# VITE_CONTACT_API_URL=https://mi-portafolio-contact.vientonorte.workers.dev/api/contact